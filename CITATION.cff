    given-names: "Francisco"
repository-code: "https://github.com/Agnuxo1/Neuro3D-Lab"
keywords:
  - optics
  - diffraction
  - angular spectrum
  - diffractive neural networks
  - Blender
  - finite-support simulation
  - reproducibility
